  <diagram name="2. Data and variables" id="page2">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2_title" value="Data: from raw rater rows to one master table" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2_raw" value="&lt;b&gt;RAW: goemotions_1/2/3.csv&lt;/b&gt;&lt;br&gt;one row per rater per comment (~211k rows)&lt;br&gt;text · id · author · subreddit · link_id · parent_id · created_utc · rater_id · 28 binary emotions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p2_simp" value="&lt;b&gt;SIMPLIFIED: train / dev / test .tsv&lt;/b&gt;&lt;br&gt;43,410 / 5,426 / 5,427 comments, no header&lt;br&gt;text · emotion ids · comment id&lt;br&gt;+ emotions.txt, ekman and sentiment mappings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p2_collapse" value="&lt;b&gt;Collapse raw (group by id)&lt;/b&gt;&lt;br&gt;mean of 28 emotion columns = human soft scores&lt;br&gt;n_rater = number of raters&lt;br&gt;soglasnost = highest rater-mean&lt;br&gt;author → salted hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="440" y="90" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p2_join" value="&lt;b&gt;Join simplified (on id)&lt;/b&gt;&lt;br&gt;agreed labels (28 binary)&lt;br&gt;flag: labeled (~54k) vs unlabeled (~3.7k)&lt;br&gt;split: train / dev / test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="440" y="290" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p2_master" value="&lt;b&gt;comments.csv (master table, ~58k rows)&lt;/b&gt;&lt;br&gt;text · id · author_hash · subreddit · created_utc · n_rater&lt;br&gt;28 rater means · soglasnost · labeled flag · split" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="820" y="190" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2_metrics" value="&lt;b&gt;metrics.py&lt;/b&gt;&lt;br&gt;pol, sub (TextBlob) · dol = word count&lt;br&gt;vulg = share of lexicon words · vulg_any = at least one" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="820" y="380" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2_vars" value="&lt;b&gt;Variables (Macedonian terms)&lt;/b&gt;&lt;br&gt;pol: polarity, −1 to 1&lt;br&gt;sub: subjectivity, 0 to 1&lt;br&gt;dol: length in words&lt;br&gt;vulg: vulgarity, 0 to 1&lt;br&gt;vulg_any: any profanity, 0/1&lt;br&gt;glavna_emocija: dominant emotion (idxmax of model scores)&lt;br&gt;uverenost: model confidence (top score)&lt;br&gt;razlika: margin (top minus second)&lt;br&gt;grupa: positive / negative / ambiguous / neutral&lt;br&gt;soglasnost: human agreement (max rater-mean)&lt;br&gt;n_rater: raters per comment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1220" y="90" width="420" height="400" as="geometry" />
        </mxCell>
        <mxCell id="p2_priv" value="&lt;b&gt;Privacy:&lt;/b&gt; usernames are hashed or dropped; never publish them or quote identifying comments. Some comments contain offensive language (add a content note)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="700" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2_why" value="&lt;b&gt;Why the ~3.7k unlabeled comments matter:&lt;/b&gt; the simplified files keep only comments raters agreed on. The left-out ones are where humans disagreed; dropping them would bias H5 (human ambiguity)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="700" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_raw" target="p2_collapse">
