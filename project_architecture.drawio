  <diagram name="3. Model and leakage rule" id="page3">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3_title" value="Model: train, evaluate, then score without leakage" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3_tr" value="&lt;b&gt;train.tsv&lt;/b&gt;&lt;br&gt;43,410 comments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3_m1" value="&lt;b&gt;TF-IDF + one-vs-rest Logistic Regression&lt;/b&gt;&lt;br&gt;predict_proba = 0–1 score per emotion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="260" y="90" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3_m2" value="&lt;b&gt;Tune on dev.tsv&lt;/b&gt;&lt;br&gt;C ∈ {0.5, 1, 2, 5} · ngrams (1,1) or (1,2)&lt;br&gt;one decision threshold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="550" y="80" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p3_m3" value="&lt;b&gt;Evaluate ONCE on test.tsv&lt;/b&gt;&lt;br&gt;macro-F1 + per-emotion F1&lt;br&gt;at 28 / Ekman / sentiment levels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="850" y="80" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p3_m4" value="&lt;b&gt;Model report&lt;/b&gt;&lt;br&gt;vs. 2nd model · vs. paper BERT (≈ .46 / .64 / .69)&lt;br&gt;error analysis of 30 mistakes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1140" y="80" width="270" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p3_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_tr" target="p3_m1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_m1" target="p3_m2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_m2" target="p3_m3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3_m3" target="p3_m4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_leak" value="&lt;b&gt;LEAKAGE RULE:&lt;/b&gt; a comment is never scored by a model that was trained on it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="700" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3_fb" value="&lt;b&gt;Simple fallback:&lt;/b&gt; analyze only comments never in train.tsv (dev + test + unlabeled, about 14k)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="800" y="240" width="610" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3_lab" value="&lt;b&gt;Labeled comments&lt;/b&gt;&lt;br&gt;~54k with agreed labels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3_folds" value="5 folds (shuffled, seed 42)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;verticalAlign=top;align=left;spacingLeft=10;spacingTop=3;fontStyle=1;fontColor=#666666;fontSize=12;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="290" y="340" width="640" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3_f0" value="&lt;b&gt;Fold 1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="310" y="385" width="100" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3_f1" value="&lt;b&gt;Fold 2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="430" y="385" width="100" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3_f2" value="&lt;b&gt;Fold 3&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="550" y="385" width="100" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3_f3" value="&lt;b&gt;Fold 4&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="670" y="385" width="100" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3_f4" value="&lt;b&gt;Fold 5&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="790" y="385" width="100" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3_each" value="&lt;b&gt;For each fold k:&lt;/b&gt; fit TF-IDF + model on the other 4 folds, then predict fold k (TF-IDF is refit inside each fold)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="500" width="640" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3_unl" value="&lt;b&gt;Unlabeled comments&lt;/b&gt;&lt;br&gt;~3.7k (no agreed label)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3_avg" value="&lt;b&gt;Score with every fold model, then average&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="640" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3_oof" value="&lt;b&gt;Out-of-fold score table&lt;/b&gt;&lt;br&gt;28 probabilities per comment, all ~58k" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="650" y="640" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3_san" value="&lt;b&gt;Sanity check:&lt;/b&gt; out-of-fold macro-F1 should be close to the test macro-F1. Much higher means a leakage bug." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1010" y="340" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p3_der" value="&lt;b&gt;Derived columns&lt;/b&gt;&lt;br&gt;glavna_emocija = idxmax of scores&lt;br&gt;uverenost = top score · razlika = top − second&lt;br&gt;grupa = sentiment mapping" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1010" y="520" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p3_note" value="Don't use class_weight='balanced' for the scoring model: it distorts the probabilities (you may test it for F1 and mention it)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
